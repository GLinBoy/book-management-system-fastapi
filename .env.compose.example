# Production-like Docker Compose profile.
#
# Copy this file to .env (or merge these keys into an existing .env) before
# running:
#
#   docker compose up --build
#
# APP_ENV is forced to prod for the api service by docker-compose.yml.
# Keep POSTGRES_PASSWORD in sync with the password in DATABASE_URL.
# URL-encode special characters in the password.

APP_ENV=prod
DATABASE_URL=postgresql+psycopg://books:change-me@postgres:5432/books

POSTGRES_DB=books
POSTGRES_USER=books
POSTGRES_PASSWORD=change-me

# Host port for the API (defaults to 8000).
# API_PORT=8000
