# Application profile: dev | test | prod
APP_ENV=dev

# Database URL (optional in dev/test, required when APP_ENV=prod).
# Defaults: dev -> sqlite:///./dev.db, test -> sqlite:///./test.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/books

# Connection pool settings (used for PostgreSQL only; ignored for SQLite)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_PRE_PING=true