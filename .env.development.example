# Development Docker Compose profile (loaded with docker-compose.override.yml).
#
# Copy this file to .env (or merge these keys into an existing .env) before
# running:
#
#   docker compose up --build
#
# APP_ENV is forced to dev and seeding is enabled by the override.
# Select SQLite (default) or PostgreSQL by switching DATABASE_URL.

APP_ENV=dev
SEED_ON_STARTUP=true

# SQLite in the sqlite_data volume:
DATABASE_URL=sqlite:////data/dev.db

# PostgreSQL instead (the postgres service is part of the stack):
# DATABASE_URL=postgresql+psycopg://books:dev@postgres:5432/books

POSTGRES_DB=books
POSTGRES_USER=books
POSTGRES_PASSWORD=dev

# Host port for the API (defaults to 8000).
# API_PORT=8000
